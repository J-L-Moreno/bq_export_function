config {
    type: "view",
    schema: "10_Bronze",
    description: "Union common columns into a single table along with cloud ID",
    name: "10_union_gcp"
}

SELECT
  billing_account_id,
  service_id,
  service_description,
  sku_id,
  sku_description,
  usage_start_time,
  usage_end_time,
  project_id,
  project_number,
  project_name,
  project_labels_json,
  project_ancestors_json,
  labels_json,
  system_labels_json,
  location_location,
  location_country,
  location_region,
  location_zone,
  resource_name,
  resource_global_name,
  tags_json,
  price_effective_price,
  price_tier_start_amount,
  price_unit,
  price_unit_quantity,
  price_list_price,
  price_effective_price_default,
  price_list_price_consumption_model,
  subscription_instance_id,
  transaction_type,
  seller_name,
  export_time,
  cost,
  currency,
  currency_conversion_rate,
  usage_amount,
  usage_unit,
  usage_amount_in_pricing_units,
  usage_pricing_unit,
  credits_json,
  invoice_month,
  invoice_publisher_type,
  cost_type,
  adjustment_info_id,
  adjustment_info_description,
  adjustment_info_mode,
  adjustment_info_type,
  cost_at_list,
  cost_at_effective_price_default,
  cost_at_list_consumption_model,
  consumption_model_id,
  consumption_model_description,
  metadata_json
FROM (
  SELECT
    billing_account_id,
    service.id AS service_id,
    service.description AS service_description,
    sku.id AS sku_id,
    sku.description AS sku_description,
    usage_start_time AS usage_start_time,
    usage_end_time AS usage_end_time,
    project.id AS project_id,
    project.number AS project_number,
    project.name AS project_name,
    TO_JSON_STRING(project.labels) AS project_labels_json,
    TO_JSON_STRING(project.ancestors) AS project_ancestors_json,
    TO_JSON_STRING(labels) AS labels_json,
    TO_JSON_STRING(system_labels) AS system_labels_json,
    location.location AS location_location,
    location.country AS location_country,
    location.region AS location_region,
    location.zone AS location_zone,
    resource.name AS resource_name,
    resource.global_name AS resource_global_name,
    TO_JSON_STRING(tags) AS tags_json,
    price.effective_price AS price_effective_price,
    price.tier_start_amount AS price_tier_start_amount,
    price.unit AS price_unit,
    NULL AS price_unit_quantity,
    price.list_price AS price_list_price,
    price.effective_price_default AS price_effective_price_default,
    price.list_price_consumption_model AS price_list_price_consumption_model,
    subscription.instance_id AS subscription_instance_id,
    transaction_type,
    seller_name,
    export_time,
    cost,
    currency,
    currency_conversion_rate,
    usage.amount AS usage_amount,
    usage.unit AS usage_unit,
    usage.amount_in_pricing_units AS usage_amount_in_pricing_units,
    usage.pricing_unit AS usage_pricing_unit,
    TO_JSON_STRING(credits) AS credits_json,
    invoice.month AS invoice_month,
    invoice.publisher_type AS invoice_publisher_type,
    cost_type,
    adjustment_info.id AS adjustment_info_id,
    adjustment_info.description AS adjustment_info_description,
    adjustment_info.mode AS adjustment_info_mode,
    adjustment_info.type AS adjustment_info_type,
    cost_at_list,
    cost_at_effective_price_default,
    cost_at_list_consumption_model,
    consumption_model.id AS consumption_model_id,
    consumption_model.description AS consumption_model_description,
    metadata_json AS metadata_json
  FROM
    ${ref("00_gcp_bronze_part1")} )
UNION ALL (
  SELECT
    billing_account_id,
    service.id AS service_id,
    service.description AS service_description,
    sku.id AS sku_id,
    sku.description AS sku_description,
    usage_start_time AS usage_start_time,
    usage_end_time AS usage_end_time,
    project.id AS project_id,
    project.number AS project_number,
    project.name AS project_name,
    TO_JSON_STRING(project.labels) AS project_labels_json,
    TO_JSON_STRING(project.ancestors) AS project_ancestors_json,
    TO_JSON_STRING(labels) AS labels_json,
    TO_JSON_STRING(system_labels) AS system_labels_json,
    location.location AS location_location,
    location.country AS location_country,
    location.region AS location_region,
    location.zone AS location_zone,
    NULL AS resource_name,
    NULL AS resource_global_name,
    TO_JSON_STRING(tags) AS tags_json,
    price.effective_price AS price_effective_price,
    price.tier_start_amount AS price_tier_start_amount,
    price.unit AS price_unit,
    NULL AS price_unit_quantity,
    price.list_price AS price_list_price,
    price.effective_price_default AS price_effective_price_default,
    price.list_price_consumption_model AS price_list_consumption_model,
    NULL AS subscription_instance_id,
    transaction_type,
    seller_name,
    export_time,
    cost,
    currency,
    currency_conversion_rate,
    usage.amount AS usage_amount,
    usage.unit AS usage_unit,
    usage.amount_in_pricing_units AS usage_amount_in_pricing_units,
    usage.pricing_unit AS usage_pricing_unit,
    TO_JSON_STRING(credits) AS credits_json,
    invoice.month AS invoice_month,
    invoice.publisher_type AS invoice_publisher_type,
    cost_type,
    adjustment_info.id AS adjustment_info_id,
    adjustment_info.description AS adjustment_info_description,
    adjustment_info.mode AS adjustment_info_mode,
    adjustment_info.type AS adjustment_info_type,
    NULL AS cost_at_list,
    cost_at_effective_price_default,
    cost_at_list_consumption_model,
    consumption_model.id AS consumption_model_id,
    consumption_model.description AS consumption_model_description,
    metadata_json AS metadata_json
  FROM
    ${ref("00_gcp_bronze_part2")})
